# Local infrastructure
POSTGRES_DB=synvo
POSTGRES_USER=synvo
POSTGRES_PASSWORD=synvo_local
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Frontend development
VITE_PROXY_TARGET=http://localhost:8080

# Lark connection (disabled by default so tests and Phase 0 startup need no secrets)
SYNVO_LARK_ENABLED=false
SYNVO_LARK_APP_ID=
SYNVO_LARK_APP_SECRET=
SYNVO_LARK_TRANSPORT=websocket
SYNVO_LARK_PILOT_OPEN_ID=
SYNVO_LARK_H5_BASE_URL=
SYNVO_TOKEN_ENCRYPTION_KEY=
SYNVO_SESSION_SECURE_COOKIE=true

# Phase 3 Codex runner overlay. Each host path must resolve to its explicitly
# approved local workspace folder. These defaults use the synthetic business
# workspaces tracked with the project. Codex credentials live only in the
# dedicated Compose volume and are created interactively; there is no API-key
# variable.
SYNVO_CODEX_FINANCE_WORKSPACE_HOST_PATH=./workspaces/Finance
SYNVO_CODEX_PRODUCTS_WORKSPACE_HOST_PATH=./workspaces/Products
SYNVO_CODEX_SALES_WORKSPACE_HOST_PATH=./workspaces/Sales
SYNVO_CODEX_ALLOWED_MCP_SERVERS=

# NVIDIA Nemotron model boundary (disabled for ordinary local startup)
SYNVO_MODEL_ENABLED=false
SYNVO_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
SYNVO_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
SYNVO_MODEL_API_KEY=

# Billing Insights: backend-only, explicitly opt in using compose.billing.yaml.
# Keep certificates outside this repository; set file paths, never PEM contents.
# Complete the approved local storage/backup preflight before live imports.
SYNVO_BILLING_ENABLED=false
SYNVO_AZURE_TENANT_ID=
SYNVO_AZURE_CLIENT_ID=
SYNVO_AZURE_BILLING_ACCOUNT_ID=
SYNVO_AZURE_BILLING_PROFILE_ID=
SYNVO_AZURE_PRIVATE_KEY_PATH=
SYNVO_AZURE_PUBLIC_CERT_PATH=

# Billing report UI/agent workflow is separately opt-in. The matching Compose
# overlay registers a managed Billing workspace; ordinary tasks cannot select it.
SYNVO_BILLING_WORKFLOW_ENABLED=false
SYNVO_BILLING_WORKFLOW_WORKSPACE_ID=billing
SYNVO_BILLING_WORKFLOW_PACKAGE_ROOT=/workspaces/billing
