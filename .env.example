# Local infrastructure
POSTGRES_DB=synvo
POSTGRES_USER=synvo
POSTGRES_PASSWORD=synvo_local
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Frontend development
VITE_PROXY_TARGET=http://localhost:8080

# Lark connection (disabled by default so tests and Phase 0 startup need no secrets)
SYNVO_LARK_ENABLED=false
SYNVO_LARK_APP_ID=
SYNVO_LARK_APP_SECRET=
SYNVO_LARK_TRANSPORT=websocket
SYNVO_LARK_PILOT_OPEN_ID=
SYNVO_LARK_H5_BASE_URL=
SYNVO_TOKEN_ENCRYPTION_KEY=
SYNVO_SESSION_SECURE_COOKIE=true

# NVIDIA Nemotron model boundary (disabled for ordinary local startup)
SYNVO_MODEL_ENABLED=false
SYNVO_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
SYNVO_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
SYNVO_MODEL_API_KEY=
